# Copiez ce fichier en .env et remplacez TOUTES les valeurs « change-me ».
# Générer un secret : openssl rand -base64 32

# Domaines publics (enregistrements DNS A vers l'IP du serveur Ubuntu)
BANK_API_DOMAIN=api.banque.example.com
ADMIN_DOMAIN=admin.banque.example.com
AUTH_DOMAIN=auth.banque.example.com
ACME_EMAIL=admin@example.com

# PostgreSQL
POSTGRES_SUPERUSER_PASSWORD=change-me
FINERACT_DB_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

# Fineract
FINERACT_TENANT=default
FINERACT_TIMEZONE=Europe/Paris

# Keycloak (console d'administration : https://AUTH_DOMAIN/admin)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
